<Window x:Class="Team.MembersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="成员" Width="640" Height="510" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="OnLoaded">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16"><Button Content="添加成员" Style="{StaticResource PrimaryButton}" Click="AddClick" AutomationProperties.AutomationId="AddMember"/><Button Content="编辑" Click="EditClick" AutomationProperties.AutomationId="EditMember"/><Button x:Name="StateButton" Content="停用 / 启用" Click="StateClick" AutomationProperties.AutomationId="ToggleMember"/><Button Content="刷新" Click="RefreshClick" AutomationProperties.AutomationId="RefreshMembers"/></StackPanel>
  <TextBlock x:Name="Feedback" DockPanel.Dock="Bottom" Foreground="#92382D" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="MemberError"/>
  <Grid><TextBlock x:Name="Empty" Text="暂无成员" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <ListBox x:Name="MemberList" AutomationProperties.Name="成员列表" AutomationProperties.AutomationId="MemberList" MouseDoubleClick="DoubleClick"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Role}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock Text="{Binding ClientName}" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
  </Grid>
 </DockPanel>
</Window>
