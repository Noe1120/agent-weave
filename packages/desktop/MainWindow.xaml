<Window x:Class="Team.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Team" Width="1160" Height="800" MinWidth="820" MinHeight="590" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F5F5F4" BorderBrush="#E6E6E5" BorderThickness="0,0,1,0">
   <DockPanel Margin="14,18,14,12">
    <Grid DockPanel.Dock="Top" Margin="6,0,0,22"><TextBlock Text="Team" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="NewProject" Content="＋" FontSize="20" HorizontalAlignment="Right" Click="NewProjectClick" ToolTip="新建项目 (Ctrl+N)" AutomationProperties.Name="新建项目" AutomationProperties.AutomationId="NewProject"/></Grid>
    <Button DockPanel.Dock="Bottom" Content="关于" HorizontalAlignment="Left" Foreground="{StaticResource Muted}" Click="AboutClick" AutomationProperties.AutomationId="About"/>
    <ListBox x:Name="ProjectList" AutomationProperties.Name="项目" AutomationProperties.AutomationId="ProjectList" SelectionChanged="ProjectChanged" DisplayMemberPath="Name"/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,18,28,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="ProjectTitle" Text="项目" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="MembersButton" Content="成员" Click="MembersClick" AutomationProperties.AutomationId="Members"/>
     <Button x:Name="ProgressButton" Content="进度" Click="ProgressClick" AutomationProperties.AutomationId="Progress"/>
     <Button x:Name="RefreshButton" Content="刷新" Click="RefreshClick" ToolTip="刷新 (F5)" AutomationProperties.AutomationId="Refresh"/>
    </StackPanel>
   </Grid>
   <Border x:Name="ErrorPanel" Grid.Row="1" Visibility="Collapsed" Background="#FFF1EE" CornerRadius="6" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="ErrorText" Foreground="#92382D" AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="Error"/></Border>
   <Grid Grid.Row="2">
    <TextBlock x:Name="EmptyProject" Text="暂无项目" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
    <TabControl x:Name="ContentTabs" Visibility="Collapsed" BorderThickness="0" Background="White" AutomationProperties.AutomationId="WorkspaceTabs">
     <TabItem Header="对话" AutomationProperties.AutomationId="ConversationTab">
      <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="查找" Click="SearchClick" AutomationProperties.AutomationId="Search"/><Button x:Name="ClearSearch" DockPanel.Dock="Right" Content="清除" Visibility="Collapsed" Click="ClearSearchClick" AutomationProperties.AutomationId="ClearSearch"/><TextBox x:Name="SearchInput" MaxLength="200" KeyDown="SearchKey" VerticalAlignment="Center" AutomationProperties.Name="搜索消息" AutomationProperties.AutomationId="SearchInput"/></DockPanel>
       <Grid Grid.Row="1">
        <TextBlock x:Name="EmptyMessages" Text="暂无消息" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel><Button x:Name="OlderMessages" Content="较早消息" HorizontalAlignment="Center" Visibility="Collapsed" Click="OlderClick" AutomationProperties.AutomationId="OlderMessages"/>
          <ItemsControl x:Name="MessageList" AutomationProperties.AutomationId="MessageList"><ItemsControl.ItemTemplate><DataTemplate>
           <Border BorderBrush="#EEEEF0" BorderThickness="0,0,0,1" Padding="0,12,0,14" Margin="0,0,12,0">
            <StackPanel><DockPanel Margin="0,0,0,7"><TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/></DockPanel><TextBox Text="{Binding Body,Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         </StackPanel>
        </ScrollViewer>
       </Grid>
       <Border Grid.Row="2" BorderBrush="#DCDCDD" BorderThickness="1" CornerRadius="7" Margin="0,16,0,0" Padding="10">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBox x:Name="MessageInput" AutomationProperties.Name="消息内容" AutomationProperties.AutomationId="MessageInput" MinHeight="70" MaxHeight="180" BorderThickness="0" Padding="4" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="8000" TextChanged="ComposerChanged" KeyDown="ComposerKey"/>
         <Grid Grid.Row="1" Margin="0,8,0,0"><ComboBox x:Name="Recipient" Width="200" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="RecipientChanged" AutomationProperties.Name="收件人" AutomationProperties.AutomationId="Recipient"/><Button x:Name="SaveMessage" Content="保存消息" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="SaveMessageClick" ToolTip="保存消息 (Ctrl+Enter)" AutomationProperties.AutomationId="SaveMessage"/></Grid>
        </Grid>
       </Border>
      </Grid>
     </TabItem>
     <TabItem Header="任务草稿" AutomationProperties.AutomationId="TasksTab">
      <DockPanel Margin="0,14,0,0">
       <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Button Content="新建任务" Style="{StaticResource PrimaryButton}" Click="NewTaskClick" AutomationProperties.AutomationId="NewTask"/><Button Content="编辑" Click="EditTaskClick" AutomationProperties.AutomationId="EditTask"/><Button x:Name="ArchiveTask" Content="归档" Click="ArchiveTaskClick" AutomationProperties.AutomationId="ArchiveTask"/></StackPanel><CheckBox x:Name="ShowArchived" Content="已归档" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ArchiveFilterChanged" Unchecked="ArchiveFilterChanged" AutomationProperties.AutomationId="ShowArchived"/></Grid>
       <Grid><TextBlock x:Name="EmptyTasks" Text="暂无任务" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <ListBox x:Name="TaskList" MouseDoubleClick="TaskDoubleClick" KeyDown="TaskKey" AutomationProperties.Name="任务草稿" AutomationProperties.AutomationId="TaskList"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" MaxHeight="40" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
       </Grid>
      </DockPanel>
     </TabItem>
    </TabControl>
   </Grid>
   <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="Reconnect" DockPanel.Dock="Right" Content="重新连接" Visibility="Collapsed" Click="ReconnectClick" AutomationProperties.AutomationId="Reconnect"/><TextBlock x:Name="StatusText" Text="正在连接…" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="Status"/></DockPanel>
  </Grid>
 </Grid>
</Window>
