        },
        "expected_plan_token": {
          "$ref": "#/$defs/opaque"
        },
        "approval_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "disclosure_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "delegation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_resource_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/versionAssertion"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "contract_version",
        "kind",
        "request_id",
        "project_id",
        "action_id",
        "plan_ref",
        "expected_plan_token",
        "expected_resource_versions",
        "approval_refs",
        "disclosure_refs",
        "delegation_ref"
      ],
      "additionalProperties": false
    },
