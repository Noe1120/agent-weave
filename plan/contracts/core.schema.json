        "state": {
          "type": "string",
          "enum": [
            "registered",
            "resolved",
            "consumed",
            "cancelled",
            "expired",
            "invalidated"
          ]
        },
        "resolution_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_ref": {
