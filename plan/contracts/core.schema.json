          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "operation": {
          "type": "string",
          "enum": [
            "apply_plan",
            "control_plan",
            "consume_wait",
            "continuation_reply",
            "read_action",
            "register_wait",
            "read_wait",
            "get_plan_progress"
          ]
        },
        "code": {
          "type": "string",
          "enum": [
            "UNSUPPORTED_CONTRACT",
            "INVALID_REQUEST",
            "NOT_FOUND_OR_DENIED",
            "GRANT_REVOKED",
            "PLAN_STALE",
            "PLAN_CONFLICT",
            "ACTION_PAYLOAD_CONFLICT",
            "WAIT_CONFLICT",
            "WAIT_STALE",
            "CURSOR_EXPIRED",
            "INPUT_REQUEST_STALE",
            "EXECUTION_UNKNOWN",
            "DISCLOSURE_APPROVAL_REQUIRED",
            "BUDGET_UNAVAILABLE",
            "DISCLOSURE_STALE",
            "DELEGATION_EXPIRED",
            "REASSIGNMENT_REQUIRES_HANDOFF",
            "MODEL_CAPABILITY_UNAVAILABLE",
            "MODEL_OUTPUT_INVALID",
            "RETRIEVAL_INCOMPLETE",
            "INDEX_STALE"
          ]
        },
        "retry_class": {
          "type": "string",
          "enum": [
            "never",
            "after_refresh",
            "after_reconcile"
          ]
        },
        "safe_message_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,100}$"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "kind",
        "request_id",
        "project_id",
        "operation",
        "code",
        "retry_class",
        "safe_message_key",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "visible_event": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "core/1.0"
        },
        "kind": {
          "const": "visible_event"
        },
        "event_id": {
          "$ref": "#/$defs/uuid"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "wait_resolved",
            "task_state_changed",
            "plan_state_changed",
            "control_outcome_changed",
            "wait_state_changed"
          ]
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "entity_ref": {
          "$ref": "#/$defs/ref"
        },
        "stream_cursor": {
          "$ref": "#/$defs/opaque"
        },
        "resolution_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "contract_version",
        "kind",
        "event_id",
        "event_type",
        "project_id",
        "entity_ref",
        "stream_cursor",
        "resolution_id",
        "occurred_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "wait_resolved"
              }
            }
          },
          "then": {
            "properties": {
              "resolution_id": {
                "$ref": "#/$defs/uuid"
              }
            }
          }
        }
      ]
    }
  }
}
