      "required": [
        "wait_id",
        "workflow_id",
        "run_id",
        "run_epoch",
        "target_task_id",
        "revision",
        "state",
        "resolution_id",
        "result_ref",
        "deadline"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "resolved",
                  "consumed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resolution_id": {
                "$ref": "#/$defs/uuid"
              },
              "result_ref": {
                "$ref": "#/$defs/ref"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "registered"
              }
            }
          },
          "then": {
            "properties": {
              "resolution_id": {
                "type": "null"
              },
              "result_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "plan_progress": {
      "type": "object",
      "properties": {
        "plan_execution_id": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "scope_ref": {
          "$ref": "#/$defs/ref"
        },
        "view_scope": {
          "const": "full_authorized_scope"
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "stopping",
            "closed"
          ]
        },
        "dispatch_gate": {
          "type": "string",
          "enum": [
            "open",
            "paused",
            "closed"
          ]
        },
        "health": {
          "type": "string",
          "enum": [
            "healthy",
            "partial_failure",
            "blocked",
            "unknown"
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "succeeded",
                "partial",
                "failed",
                "cancelled"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "task_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "budget_state": {
          "type": "string",
          "enum": [
            "reserved",
            "reconciling",
            "settled",
            "bounded_pending_charge"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "plan_execution_id",
        "revision",
        "scope_ref",
        "view_scope",
        "lifecycle",
        "dispatch_gate",
        "health",
        "outcome",
        "task_refs",
        "evidence_refs",
        "budget_state",
        "observed_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "closed"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "partial",
                  "failed",
                  "cancelled"
                ]
              },
              "dispatch_gate": {
                "const": "closed"
              },
              "health": {
                "not": {
                  "const": "unknown"
                }
              },
              "budget_state": {
                "enum": [
                  "settled",
                  "bounded_pending_charge"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "outcome": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "stopping"
              }
            }
          },
          "then": {
            "properties": {
              "dispatch_gate": {
                "const": "closed"
              }
            }
          }
        }
      ]
    },
