  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "epoch": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "opaque": {
      "type": "string",
      "minLength": 16,
      "maxLength": 2048
    },
    "ref": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "versionAssertion": {
      "type": "object",
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "task",
            "acceptance",
            "requirements",
            "capability",
            "policy",
            "changeset",
            "environment",
            "plan_execution"
          ]
        },
        "ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "entity_type",
        "ref"
      ],
      "additionalProperties": false
    },
    "apply_plan": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "core/1.0"
